# SECRET_KEY 务必固定（用于会话签名 + 加密 SMTP 授权码）。
# 若不固定，重启后已保存的邮箱授权码会解不开、需要重填。
SECRET_KEY=change-this-to-a-long-random-string
DATABASE=/data/simhub.sqlite
TZ=Asia/Shanghai

# 邮件功能（登录两步验证 / 卡片到期提醒）现在直接在网页「设置」里配置，
# 无需环境变量。下面这几项只是可选的兜底默认值，一般留空即可。
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
