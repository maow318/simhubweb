# SECRET_KEY 务必固定（用于会话签名）。若不固定，重启后登录态会失效。
SECRET_KEY=change-this-to-a-long-random-string
# DATA_ENCRYPTION_KEY 用于加密 SMTP / Telegram 密钥和 eSIM 敏感字段；生产环境必须单独生成并固定。
DATA_ENCRYPTION_KEY=change-this-to-another-long-random-string
# 首次公网初始化建议设置；创建管理员时必须输入，避免 /setup 被他人抢先注册。
# 本地开发可留空，保持首次进入直接创建管理员的体验。
# SETUP_TOKEN=change-this-first-run-token
DATABASE=/data/simhub.sqlite
TZ=Asia/Shanghai

# 单次 API 请求体上限，默认 8MB；导入 JSON 也会限制最多 1000 张卡片。
MAX_CONTENT_LENGTH=8388608
MAX_IMPORT_CARDS=1000

# Docker 自动提醒 worker 的扫描间隔，默认每小时扫一次。
# 支持到期提醒和单卡操作提醒；发送成功后写入 reminder_log，同一张卡同一事件同一渠道同一天不会重复发送。
REMINDER_SCAN_INTERVAL_SECONDS=3600

# 仅当部署在「会覆盖 X-Forwarded-For 的可信反代」（如本仓库 Caddy 示例）后才设为 1。
# docker-compose.prod.yml 默认启用；裸 Flask 直连请保持留空/0，否则限流可被伪造头绕过。
# TRUST_PROXY=1

# HTTPS 生产部署建议开启；本地 HTTP 测试不要开启 SESSION_COOKIE_SECURE。
# SESSION_COOKIE_SECURE=1
# ENABLE_HSTS=1

# 生产 HTTPS 部署（docker-compose.prod.yml）用，指向你的域名。
# 该域名的 DNS A 记录需先指向本服务器。
SIMHUB_DOMAIN=simhub.example.com
# Telegram webhook 等公网回调使用；通常不填也会从 SIMHUB_DOMAIN 自动生成 https://域名。
# PUBLIC_BASE_URL=https://simhub.example.com

# 邮件功能（登录两步验证 / 卡片到期提醒）现在直接在网页「设置」里配置，
# 无需环境变量。下面这几项只是可选的兜底默认值，一般留空即可。
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
